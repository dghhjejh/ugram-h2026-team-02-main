# Environment Variables Template
APP_ENV=development

# Database selection
# Local development uses the Docker Postgres container on localhost:5433.
DATABASE_MODE=local
SQL_ECHO=false
TRENDING_CACHE_TTL_SECONDS=5
S3_VIEW_URL_CACHE_TTL_SECONDS=300
S3_VIEW_URL_CACHE_MAX_ENTRIES=1000
LOCAL_DATABASE_URL=postgresql://user:pass@localhost:5433/ugram

# Optional modes:
# DATABASE_MODE=rds
# RDS_DATABASE_URL=postgresql://<user>:<pass>@<rds-endpoint>:5432/ugram
#
# DATABASE_MODE=custom
# DATABASE_URL=postgresql://<user>:<pass>@<host>:5432/ugram

# Local database defaults
# user: user
# password: pass
# database: ugram

# JWT Authentication Configuration
# Generate a secure random key with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================
# Google OAuth
# =========================
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v3/certs
FRONTEND_URL=http://localhost:5173
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=ask_jad_for_it
GOOGLE_CLIENT_SECRET=ask_jad_for_it
VITE_API_URL=http://localhost:8001

# =========================
# Sentry (Shared)
# =========================
# Leave these unset unless you want Sentry locally.
SENTRY_FRONTEND_DSN=
SENTRY_DSN=

# =========================
# Sentry Optional Overrides
# =========================
# These all have code defaults, so keep them commented unless you need an override.
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=ugram@local
# SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_REPLAYS_SESSION_SAMPLE_RATE=1.0
# SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1.0
# SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0
# SENTRY_SEND_DEFAULT_PII=false
# SENTRY_ENABLE_LOGS=false

# =========================
# Sentry Vite Source Maps (CI/Build only)
# =========================
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
